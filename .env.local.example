# ============================================================================
# Panaceutics — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase — find these in: Supabase Dashboard → Project Settings → API
# ---------------------------------------------------------------------------

# Public URL for your Supabase project (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe to expose to the browser; RLS enforces access control)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — server-side only. Bypasses RLS.
# NEVER prefix with NEXT_PUBLIC_ and NEVER commit this value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Admin dashboard
# ---------------------------------------------------------------------------

# Password protecting the /admin/qr dashboard and API.
# Server-side only — do NOT prefix with NEXT_PUBLIC_.
# Set to any strong secret string (e.g. a random 32-char password).
ADMIN_SECRET=your-strong-admin-password
